
---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { arquitectura } from '../../../data/categorias.js';

export function getStaticPaths() {
  return [
    {
      params: { numero: '2' },
      props: { paginaActual: 2 }
    }
  ];
}

const { paginaActual } = Astro.props;

const proyectosPorPagina = 8;
const totalPaginas = Math.ceil(
  arquitectura.length / proyectosPorPagina
);

const inicio = (paginaActual - 1) * proyectosPorPagina;

const proyectosPagina = arquitectura.slice(
  inicio,
  inicio + proyectosPorPagina
);
---

<BaseLayout title="Arquitectura">
  <main class="portfolio">
    <div class="project-grid">
      {proyectosPagina.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <nav class="pagination" aria-label="Páginas de arquitectura">
      {Array.from({ length: totalPaginas }, (_, i) => i + 1).map((pagina) => (
        <a
          href={pagina === 1
            ? '/arquitectura/'
            : `/arquitectura/page/${pagina}/`}
          aria-current={pagina === paginaActual ? 'page' : undefined}
        >
          {pagina}
        </a>
      ))}
    </nav>
  </main>
</BaseLayout>
