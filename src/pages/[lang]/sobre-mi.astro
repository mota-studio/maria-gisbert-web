const t = texts[lang];
const months = t.months;
const pageSlug = 'sobre-mi';
---
<BaseLayout title={t.about}>
  <main class="about-page">
    <article class="about-content">
      <h1>{t.about}</h1>
      <img src="/images/about/maria.jpg" alt="María Gisbert" class="about-photo" />
      <div class="about-description">
        <p>{t.intro}</p>
        <p>{t.services}</p>
        <p>– <strong>{t.drawing}</strong> (Autocad, Rhinoceros, Revit (BIM), 3D Studio, Photoshop...),</p>
        <p>– <strong>{t.video}</strong> (Premiere, Pinnacle),</p>
        <p>– <strong>{t.costs}</strong> (Presto),</p>
        <p>– {t.office}...</p>
      </div>
    </article>
    <aside class="about-sidebar">
      <section class="sidebar-section">
        <form class="sidebar-search" role="search">
          <input type="search" aria-label={t.search} />
          <button type="submit">{t.search}</button>
        </form>
      </section>
      <section class="sidebar-section">
        <h2>{t.recent}</h2>
        <ul>{['HABITAR COACV 2016','VI PORCELANOSA','I MATIMEX','TRANS-HITOS 2017','DENTALART'].map(name => <li>{name}</li>)}</ul>
      </section>
      <section class="sidebar-section"><h2>{t.comments}</h2></section>
      <section class="sidebar-section">
        <h2>{t.archives}</h2>
        <ul>{months.map(month => <li>{month}</li>)}</ul>
      </section>
      <section class="sidebar-section">
        <h2>{t.categories}</h2>
        <ul>{t.categoryNames.map((name, i) => <li><a href={`/${lang}/${['arquitectura','diseno-grafico','infografias','mobiliario'][i]}/`}>{name}</a></li>)}</ul>
      </section>
      <section class="sidebar-section">
        <h2>{t.meta}</h2>
        <ul>{t.metaItems.map(name => <li>{name}</li>)}</ul>
      </section>
      <section class="sidebar-section">
        <h2>{t.language}</h2>
        <ul>{[['es','Español'],['en','English'],['fr','Français'],['ca','Català']].map(([code,name]) => <li><a href={code === 'es' ? `/${pageSlug}/` : `/${code}/${pageSlug}/`}>{name}</a></li>)}</ul>
      </section>
    </aside>
  </main>
  <footer class="site-footer">© 2012 Grid Theme Responsive Free Wordpress Theme. All Rights Reserved.</footer>
</BaseLayout>
