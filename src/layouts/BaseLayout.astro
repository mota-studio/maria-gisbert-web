
---
/* ==========================================
   MARÍA GISBERT — BASE LAYOUT
========================================== */

/* 01. IMPORTACIONES */

import '../styles/global.css';
import Header from '../components/Header.astro';
import { obtenerIdioma } from '../i18n/config.js';

/* 02. PROPIEDADES */

interface Props {
  title: string;
}

const { title } = Astro.props;

/* 03. DETECTAR IDIOMA ACTUAL */

const idioma = obtenerIdioma(Astro.url.pathname);

/* 04. TÍTULO DE LA PÁGINA */

const pageTitle =
  title === 'Inicio'
    ? 'mery'
    : `${title} « mery`;

/* 05. DESCRIPCIONES SEO POR IDIOMA */

const descripciones = {
  es: 'Portfolio de María Gisbert. Arquitectura, infografía, diseño gráfico y mobiliario.',

  en: 'María Gisbert portfolio. Architecture, infographics, graphic design and furniture.',

  fr: 'Portfolio de María Gisbert. Architecture, infographie, design graphique et mobilier.',

  ca: 'Portafolis de María Gisbert. Arquitectura, infografia, disseny gràfic i mobiliari.'
};

const descripcion =
  descripciones[idioma as keyof typeof descripciones];
---

<!doctype html>

<html lang={idioma}>

  <head>

    <!-- ======================================
         01. CONFIGURACIÓN GENERAL
    ======================================= -->

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <!-- ======================================
         02. DESCRIPCIÓN SEO
    ======================================= -->

    <meta
      name="description"
      content={descripcion}
    />

    <!-- ======================================
         03. FAVICON
    ======================================= -->

    <link
      rel="icon"
      type="image/x-icon"
      href="/images/logo/favicon.svg?=v=1"
    />

    <!-- ======================================
         04. TÍTULO DE LA PÁGINA
    ======================================= -->

    <title>{pageTitle}</title>

  </head>

  <body>

    <!-- ======================================
         05. HEADER COMPARTIDO
    ======================================= -->

    <Header />

    <!-- ======================================
         06. CONTENIDO DE CADA PÁGINA
    ======================================= -->

    <slot />

  </body>

</html>
